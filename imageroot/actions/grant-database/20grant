#
# Create or update the database and the owner role of a client and return
# its credentials (role pgclient). Every call rotates the password. The
# password reaches PostgreSQL as a SCRAM-SHA-256 verifier only; the clear
# text exists only in this output (kept by NS8 under this module's task
# keys, readable by the caller and the cluster administrators) and, when
# OpenBao is on, in OpenBao for OpenBao-aware applications. It is never
# logged and never stored locally.
#

import json
import sys

import agent
import pgha
import pgha_secrets as ps

data = json.load(sys.stdin)
if not pgha.role():
    pgha.validation_error("", "", "not_configured")
client_id = pgha.resolve_client_id(data)
database = (data.get("database") or "").strip() or pgha.database_name_for(client_id)
if not pgha.valid_database_name(database):
    pgha.validation_error("database", database, "invalid")

owner = pgha.psql(
    f"SELECT COALESCE(shobj_description(oid, 'pg_authid'), '') FROM pg_roles WHERE rolname = {pgha.quote_literal(database)};"
).strip()
if owner and owner != f"ns8-client={client_id}":
    pgha.validation_error("database", database, "database_owned_by_other")
dbowner = pgha.psql(
    f"SELECT COALESCE(shobj_description(oid, 'pg_database'), '') FROM pg_database WHERE datname = {pgha.quote_literal(database)};"
).strip()
if dbowner and dbowner != f"ns8-client={client_id}":
    pgha.validation_error("database", database, "database_owned_by_other")

password = pgha.new_password()
pgha.psql(pgha.grant_sql(database, client_id, pgha.scram_sha256_verifier(password)), tuples=False)
print(f"Database {database} granted to {client_id}", file=sys.stderr)

rdb = agent.redis_connect(use_replica=True)
endpoints = pgha.client_endpoints(rdb)
caller_node = ""
caller = pgha.caller_module()
if caller:
    caller_node = rdb.hget(f"module/{caller}/environment", "NODE_ID") or ""
best = pgha.pick_endpoint(endpoints, caller_node)
output = {
    "client_id": client_id,
    "database": database,
    "username": database,
    "password": password,
    "host": best["host"],
    "port": best["port"],
    "ro_port": best["ro_port"],
    "endpoints": endpoints,
    "ha_mode": pgha.ha_mode(),
    "cluster_id": pgha.cluster_id(),
    "tls": False,
    "sslmode": "disable",
    "url": f"postgresql://{database}:{password}@{best['host']}:{best['port']}/{database}?sslmode=disable",
}
if ps.vault_settings()["vault_enabled"]:
    mgr = ps.manager()
    name = f"client/{database}"
    try:
        mgr.set_secret(name, json.dumps({"username": database, "password": password, "database": database,
                                         "host": best["host"], "port": best["port"]}), local=False)
        output["openbao_path"] = mgr.vault.secret_path(name)
    except ps.SecretError as ex:
        print(agent.SD_WARNING + f"The credentials were not stored in OpenBao: {ex}", file=sys.stderr)
json.dump(output, fp=sys.stdout)
