# Copy the OpenBao-only secrets to local 0600 files (administrators), so
# OpenBao can be turned off without losing them. Lists names, never
# values; fails if any item could not be copied.

import json
import sys

import agent
import pgha_secrets as ps

if not ps.vault_settings()["vault_enabled"]:
    agent.set_status("validation-failed")
    json.dump([{"field": "vault_enabled", "parameter": "vault_enabled", "value": False,
                "error": "openbao_disabled"}], fp=sys.stdout)
    sys.exit(3)
copied, failed = ps.manager().copy_to_local()
json.dump({"copied": copied, "failed": failed}, fp=sys.stdout)
sys.exit(1 if failed else 0)
