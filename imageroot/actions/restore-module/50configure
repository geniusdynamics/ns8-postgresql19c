# Start the restored instance as a new standalone server (empty data,
# new CA: the CA files are not in the backup), with the restored
# settings. Let's Encrypt is never restored: DNS may not point here yet.

import os
import sys

import agent
import agent.tasks
import pgha

pgha.ensure_ca()
ret = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data={
    "role": "standalone",
    "replication_mode": pgha.replication_mode(),
    "max_connections": pgha.max_connections(),
    "pgadmin_enabled": pgha.env("PGADMIN_ENABLED") == "1" and bool(pgha.env("TRAEFIK_HOST") or pgha.env("PGADMIN_PATH")),
    "host": pgha.env("TRAEFIK_HOST"),
    "pgadmin_path": pgha.env("PGADMIN_PATH"),
    "http2https": pgha.env("TRAEFIK_HTTP2HTTPS", "True").lower() == "true",
    "lets_encrypt": False,
})
agent.assert_exp(ret["exit_code"] == 0, "configure-module failed")
