#
# Register this PostgreSQL cluster in the OpenBao database secrets engine
# (administrators). The ns8_openbao role (LOGIN CREATEROLE, not superuser)
# gets a new password that is sent to OpenBao only, then OpenBao rotates
# it (rotate_root, default true): the module does not keep it. The
# connection uses the client endpoint of this instance on the VPN, so it
# follows the primary. Warpgate and other applications that read a static
# database URL keep using grant-database.
#

import json
import sys

import agent
import pgha
import pgha_secrets as ps

data = json.load(sys.stdin)
settings = ps.vault_settings()
if not settings["vault_enabled"] or not pgha.role():
    pgha.validation_error("vault_enabled", False, "openbao_disabled")
mount = data.get("mount") or "database"
name = data.get("connection") or pgha.cluster_id()
allowed = data.get("allowed_roles") or ["*"]

password = pgha.new_password()
role_q = pgha.quote_ident(ps.ENGINE_ROLE)
verifier = pgha.quote_literal(pgha.scram_sha256_verifier(password))
pgha.psql("\n".join([
    "\\set ON_ERROR_STOP on",
    f"SELECT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{ps.ENGINE_ROLE}') AS engine_exists \\gset",
    "\\if :engine_exists",
    f"ALTER ROLE {role_q} WITH LOGIN CREATEROLE NOSUPERUSER NOCREATEDB NOREPLICATION PASSWORD {verifier};",
    "\\else",
    f"CREATE ROLE {role_q} WITH LOGIN CREATEROLE NOSUPERUSER NOCREATEDB NOREPLICATION PASSWORD {verifier};",
    "\\endif",
    f"COMMENT ON ROLE {role_q} IS 'ns8-openbao-database-engine';",
    f"GRANT CONNECT ON DATABASE postgres TO {role_q};",
    "",
]), tuples=False)

endpoint = pgha.pick_endpoint(pgha.client_endpoints())
vault = ps.make_vault(settings)
try:
    ps.register_database_engine(vault, mount, name, endpoint["host"], endpoint["port"], password, allowed,
                                rotate=data.get("rotate_root", True))
except ps.OpenBaoUnavailable:
    pgha.validation_error("vault_address", settings["vault_address"], "openbao_unreachable")
except ps.OpenBaoHTTPError as ex:
    print(agent.SD_ERR + f"OpenBao refused the database engine configuration: {ex}", file=sys.stderr)
    pgha.validation_error("mount", mount, "openbao_denied" if ex.status in (401, 403) else "openbao_error")
print(f"OpenBao database engine {mount}/config/{name} registered", file=sys.stderr)
json.dump({"mount": mount, "connection": name, "endpoint": f"{endpoint['host']}:{endpoint['port']}",
           "username": ps.ENGINE_ROLE, "allowed_roles": allowed,
           "root_rotated": data.get("rotate_root", True)}, fp=sys.stdout)
