{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Revoke a database",
    "$id": "http://nethserver.org/json-schema/task/input/postgresql19c/revoke-database",
    "description": "Role pgclient. Disable the login of the owner role of a client database (default), or drop the database and the role (drop: true). A module caller acts on its own databases only",
    "examples": [{}, {"database": "warpgate1", "drop": true}],
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "client_id": {"type": "string", "pattern": "^([a-z][a-z0-9_.-]{0,62})?$"},
        "database": {"type": "string", "pattern": "^([a-z][a-z0-9_]{0,62})?$"},
        "drop": {"type": "boolean"}
    }
}
