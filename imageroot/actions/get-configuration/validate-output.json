{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "postgresql19c configuration",
    "$id": "http://nethserver.org/json-schema/task/output/postgresql19c/get-configuration",
    "type": "object",
    "required": [
        "role",
        "configured",
        "cluster_id",
        "replication_mode",
        "max_connections",
        "endpoint",
        "cluster_candidates",
        "peer_candidates",
        "vault_enabled",
        "vault_token_set"
    ],
    "not": {
        "anyOf": [
            {
                "required": [
                    "vault_token"
                ]
            },
            {
                "required": [
                    "pgadmin_password"
                ]
            },
            {
                "required": [
                    "password"
                ]
            },
            {
                "required": [
                    "ca_key"
                ]
            }
        ]
    },
    "properties": {
        "role": {
            "type": "string",
            "enum": [
                "",
                "standalone",
                "initial",
                "join",
                "witness"
            ]
        },
        "configured": {
            "type": "boolean"
        },
        "cluster_id": {
            "type": "string"
        },
        "ha_mode": {
            "type": "string",
            "enum": [
                "standalone",
                "cluster"
            ]
        },
        "replication_mode": {
            "type": "string",
            "enum": [
                "async",
                "sync"
            ]
        },
        "max_connections": {
            "type": "integer"
        },
        "allow_same_node": {
            "type": "boolean"
        },
        "vpn_address": {
            "type": "string"
        },
        "endpoint": {
            "type": "object"
        },
        "ports": {
            "type": "object"
        },
        "members": {
            "type": "array"
        },
        "cluster_candidates": {
            "type": "array"
        },
        "peer_candidates": {
            "type": "array"
        },
        "pgadmin_enabled": {
            "type": "boolean"
        },
        "host": {
            "type": "string"
        },
        "http2https": {
            "type": "boolean"
        },
        "lets_encrypt": {
            "type": "boolean"
        },
        "pgadmin_email": {
            "type": "string"
        },
        "pgadmin_password_set": {
            "type": "boolean"
        },
        "superuser_password_set": {
            "type": "boolean"
        },
        "replication_password_set": {
            "type": "boolean"
        },
        "vault_enabled": {
            "type": "boolean"
        },
        "vault_address": {
            "type": "string"
        },
        "vault_token_set": {
            "type": "boolean"
        },
        "vault_mount": {
            "type": "string"
        },
        "vault_path": {
            "type": "string"
        },
        "vault_tls_skip_verify": {
            "type": "boolean"
        },
        "vault_auth": {"type": "string", "enum": ["token", "provisioned"]},
        "vault_provider": {"type": "string"},
        "vault_client": {
            "type": "object",
            "description": "Provisioned mode state, without tokens",
            "properties": {
                "active": {"type": "boolean"},
                "openbao_module_id": {"type": "string"},
                "address": {"type": "string"},
                "kv_mount": {"type": "string"},
                "kv_prefix": {"type": "string"},
                "database_engine": {"type": "boolean"},
                "database_mount": {"type": "string"},
                "groups": {"type": "array", "items": {"type": "string"}},
                "issued_at": {"type": "integer"},
                "renewed_at": {"type": "integer"}
            }
        },
        "vault_only_secrets": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "pgadmin_path": {
            "type": "string"
        },
        "pgadmin_ip_allowlist": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "public_access_enabled": {
            "type": "boolean"
        },
        "public_access_allowlist": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "public_port": {
            "type": "integer"
        },
        "tls_ca_certificate": {
            "type": "string"
        }
    }
}
