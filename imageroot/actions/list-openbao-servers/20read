# OpenBao instances of the cluster, offered by the UI as VAULT_ADDR.
# geniusdynamics/ns8-openbao publishes module/<id>/srv/http/openbao when its
# "Cluster network API" is enabled: those instances are listed in
# "servers". The other openbao instances of the cluster are listed in
# "unpublished", so the UI can say which setting to turn on. The manual URL
# remains the fallback (an external OpenBao or Vault).

import json
import sys
import agent

servers = []
unpublished = []
try:
    rdb = agent.redis_connect(use_replica=True)
    published = set()
    for provider in agent.list_service_providers(rdb, 'openbao', 'http'):
        url = provider.get('url') or f"http://{provider.get('host')}:{provider.get('port')}"
        published.add(provider.get("module_id", ""))
        servers.append({
            "module_id": provider.get("module_id", ""),
            "ui_name": provider.get("ui_name") or "",
            "node": str(provider.get("node", "")),
            "url": url,
        })
    for module_id, node_id in sorted((rdb.hgetall("cluster/module_node") or {}).items()):
        if module_id in published:
            continue
        image_url = rdb.hget(f"module/{module_id}/environment", "IMAGE_URL") or ""
        image_name = image_url.rsplit("/", 1)[-1].split(":", 1)[0].split("@", 1)[0]
        if image_name == "openbao":
            unpublished.append({
                "module_id": module_id,
                "ui_name": rdb.get(f"module/{module_id}/ui_name") or "",
                "node": str(node_id),
            })
except Exception as ex:
    print(agent.SD_WARNING + f"Cannot list the OpenBao services: {ex}", file=sys.stderr)

json.dump({"servers": servers, "unpublished": unpublished}, fp=sys.stdout)
