# An owner action: the reader and pgpeer roles cannot change approvals

import json
import sys

import pgha_peer_access as access

data = json.load(sys.stdin)
access.set_peer_access(data["peer"], data["allowed"])
json.dump({"peer": data["peer"], "allowed": data["allowed"]}, sys.stdout)
