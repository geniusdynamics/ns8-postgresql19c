# Generate the PostgreSQL and Patroni passwords and the cluster CA of a new
# instance: 0600 files under the state directory (SecretManager local
# backend). A member that joins a cluster replaces them with the cluster
# ones.

import pgha
import pgha_secrets

mgr = pgha_secrets.manager()
for name in pgha.SECRET_KEYS + ("PGADMIN_PASSWORD",):
    if not mgr.local.get(name):
        mgr.local.set(name, pgha.new_password())
pgha.ensure_ca()
