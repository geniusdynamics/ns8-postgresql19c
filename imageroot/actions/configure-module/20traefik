# Optional pgAdmin route. ns8-traefik drops it with the module.

import json
import os
import sys

import agent
import agent.tasks
import pgha

pgha.reload_env()
data = json.load(sys.stdin)
enabled = pgha.env("PGADMIN_ENABLED") == "1"
host = (data.get("host") or pgha.env("TRAEFIK_HOST")).strip()

if enabled:
    http2https = data.get("http2https", pgha.env("TRAEFIK_HTTP2HTTPS", "True").lower() == "true")
    lets_encrypt = data.get("lets_encrypt", pgha.env("TRAEFIK_LETS_ENCRYPT", "False").lower() == "true")
    agent.set_route({
        "instance": os.environ["MODULE_ID"],
        "url": "http://127.0.0.1:" + str(pgha.ports()["pgadmin"]),
        "host": host,
        "http2https": http2https,
        "lets_encrypt": lets_encrypt,
    })
    agent.mset_env({"TRAEFIK_HOST": host, "TRAEFIK_HTTP2HTTPS": str(http2https),
                    "TRAEFIK_LETS_ENCRYPT": str(lets_encrypt)})
elif pgha.env("TRAEFIK_HOST"):
    ret = agent.tasks.run(agent_id=agent.resolve_agent_id("traefik@node"), action="delete-route",
                          data={"instance": os.environ["MODULE_ID"]})
    if ret["exit_code"] != 0:
        print(agent.SD_WARNING + "The pgAdmin route was not removed", file=sys.stderr)
    agent.mset_env({"TRAEFIK_HOST": ""})
