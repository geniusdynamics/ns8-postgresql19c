#
# ExecStartPre (and ExecReload) of the module units: render the files of
# a component under state/<component>. Usage: pgha-prepare COMPONENT
#   etcd | patroni | pgproxy | pgadmin
#

import sys
import pgha

component = sys.argv[1] if len(sys.argv) > 1 else ""
if component not in pgha.UNITS:
    print(f"Unknown component {component!r}", file=sys.stderr)
    sys.exit(2)
if not pgha.role():
    print("The module is not configured yet", file=sys.stderr)
    sys.exit(1)
if component == "patroni" and not pgha.runs_postgres():
    print(f"PostgreSQL does not run with role {pgha.role()}", file=sys.stderr)
    sys.exit(1)
port_key = {"etcd": "etcd_client", "patroni": "patroni", "pgproxy": "endpoint", "pgadmin": "pgadmin"}[component]
if not pgha.ports()[port_key]:
    print(f"No TCP port for {component}", file=sys.stderr)
    sys.exit(1)
pgha.render_component(component)
