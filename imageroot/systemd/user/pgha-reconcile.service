[Unit]
Description=Periodic check of the PostgreSQL cluster membership

[Service]
Type=oneshot
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
ExecStart=runagent pgha-reconcile --timer
SyslogIdentifier=%u
