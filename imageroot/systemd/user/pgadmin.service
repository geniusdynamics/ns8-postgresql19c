#
# Optional pgAdmin, published by Traefik. Host network, listening on
# loopback only. Its login password is generated by the module (0600 file,
# shown by reveal-pgadmin-password to administrators).
#
[Unit]
Description=pgAdmin for PostgreSQL 19

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=300
TimeoutStopSec=30
ExecStartPre=/bin/rm -f %t/%N.pid %t/%N.ctr-id
ExecStartPre=runagent pgha-prepare pgadmin
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/%N.pid \
    --cidfile=%t/%N.ctr-id \
    --cgroups=no-conmon \
    --replace --name=%N \
    --network=host \
    --env=PGADMIN_LISTEN_ADDRESS=127.0.0.1 \
    --env=PGADMIN_LISTEN_PORT=${PGADMIN_PORT} \
    --env=PGADMIN_DEFAULT_EMAIL=${PGADMIN_EMAIL} \
    --env=PGADMIN_CONFIG_ENHANCED_COOKIE_PROTECTION=True \
    --env=PGADMIN_CONFIG_UPGRADE_CHECK_ENABLED=False \
    --env=PGADMIN_CONFIG_CONSOLE_LOG_LEVEL=40 \
    --env=PGADMIN_SERVER_JSON_FILE=/pgadmin4/ns8/servers.json \
    --env-file=%S/state/pgadmin/pgadmin.env \
    --volume=pgadmin-data:/var/lib/pgadmin:Z \
    --volume=%S/state/pgadmin/servers.json:/pgadmin4/ns8/servers.json:ro,Z \
    ${PGADMIN4_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%N.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/%N.ctr-id
PIDFile=%t/%N.pid
Type=forking

[Install]
WantedBy=default.target
