# A module was removed. If it was a member of this cluster (also when its
# node died and its destroy-module could not run), the primary removes
# its etcd member and every member drops it from the client endpoint. A
# removed consumer keeps its database, with login disabled.

import json
import sys

import agent
import pgha

event = json.load(sys.stdin)
removed = event.get("module", "")
if not removed or removed == pgha.env("MODULE_ID") or not pgha.role():
    sys.exit(0)

if pgha.is_cluster():
    pgha.run_reconcile(removed=removed)

# Consumer: disable the owner role of its default database, on the primary
if pgha.runs_postgres() and pgha.is_local_primary():
    database = pgha.database_name_for(removed)
    try:
        owner = pgha.psql(f"SELECT COALESCE(shobj_description(oid, 'pg_authid'), '') FROM pg_roles "
                          f"WHERE rolname = {pgha.quote_literal(database)};").strip()
        if owner == f"ns8-client={removed}":
            pgha.psql(pgha.revoke_sql(database), tuples=False)
            print(f"Login of {database} disabled: its module {removed} was removed", file=sys.stderr)
    except Exception as ex:
        print(agent.SD_WARNING + f"Cannot disable the database role of {removed}: {ex}", file=sys.stderr)
