# A member of a cluster joined, left or changed: the members of that
# cluster refresh their client endpoint and etcd membership.

import json
import subprocess
import sys

import pgha

event = json.load(sys.stdin)
if not pgha.is_cluster() or event.get("cluster_id") != pgha.cluster_id():
    sys.exit(0)
if event.get("module_id") == pgha.env("MODULE_ID"):
    sys.exit(0)
subprocess.run(["pgha-reconcile"], stdout=subprocess.DEVNULL)
